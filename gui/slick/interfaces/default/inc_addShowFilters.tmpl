#import sickgear
##
#set $checked = ' checked="checked"'
#set $selected = ' selected="selected"'
##
<% def sg_var(varname, default=False): return getattr(sickgear, varname, default) %>#slurp#
##
## the release filter and anime options of add show
##

				<div class="field-pair">
					<label for="rls_ignore_words">
						<span class="component-title">Ignore releases with any of these words</span>
						<span class="component-desc">
							<input type="text" name="rls_ignore_words" id="rls_ignore_words" value="" placeholder="e.g. [[regex:]word1, word2, ..., word_n, regex_n]" class="form-control form-control-inline input-sm input350">
							<p class="note" style="clear:both">skip a release if its name contains <em class="grey-text">any</em> of these (comma separated words or regex)</p>
						</span>
					</label>
				</div>

#if $sickgear.IGNORE_WORDS:
				<div class="field-pair">
					<label for="rls_global_exclude_ignore">
						<span class="component-title">Except these global ignore words</span>
						<span class="component-desc">
							<select id="rls_global_exclude_ignore" name="rls_global_exclude_ignore" multiple="multiple" class="form-control form-control-inline input-sm input350">
    #set $options = ''
    #set $selected = ' selected=\"selected\"'
    #set $num_selected = 0
    #for $gw in sorted($sickgear.IGNORE_WORDS, key=$str.lower):
        #set $options += "<option value=\"%s\">%s</option>" % ($gw, $gw)
    #end for
								<option value=".*"#if $num_selected then '' else $selected#># Use all global ignore words (default) #</option>
								$options
							</select>
						</span>
					</label>
				</div>
#end if

				<div class="field-pair">
					<label for="rls_require_words">
						<span class="component-title">Require one of these words</span>
						<span class="component-desc">
							<input type="text" name="rls_require_words" id="rls_require_words" value="" placeholder="e.g. [[regex:]word1, word2, ..., word_n, regex_n]" class="form-control form-control-inline input-sm input350">
							<p class="note" style="clear:both">skip a release unless its name contains <em class="grey-text">one</em> of these (comma separated words or regex)</p>
						</span>
					</label>
				</div>

#if $sickgear.REQUIRE_WORDS:
				<div class="field-pair">
					<label for="rls_global_exclude_require">
						<span class="component-title">Except these global require words</span>
						<span class="component-desc">
							<select id="rls_global_exclude_require" name="rls_global_exclude_require" multiple="multiple" class="form-control form-control-inline input-sm input350">
    #set $options = ''
    #set $selected = ' selected=\"selected\"'
    #set $num_selected = 0
    #for $gw in sorted($sickgear.REQUIRE_WORDS, key=$str.lower):
        #set $options += "<option value=\"%s\">%s</option>" % ($gw, $gw)
    #end for
								<option value=".*"#if $num_selected then '' else $selected#># Use all global require words (default) #</option>
								$options
							</select>
						</span>
					</label>
				</div>
#end if
#if $enable_anime_options
				<div class="field-pair">
					<label for="anime">
						<span class="component-title">Show is anime</span>
						<span class="component-desc">
							<input type="checkbox" name="anime" id="anime"#if $sg_var('ANIME_DEFAULT') or $kwargs.get('is_anime') then $checked else ''#>
							<p>releases are numbered like <em class="grey-text">Show.265</em>, not <em class="grey-text">Show.S02E03</em></p>
						</span>
					</label>
				</div>
#end if
