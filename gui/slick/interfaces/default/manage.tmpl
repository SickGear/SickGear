<style>
.tvShow{text-align:left}
.tvShow i{margin-right:6px; margin-bottom:1px}
.rotate-body span{float:left}
## until the table script runs, the header has the padding and the filter row space the script gives it, so nothing moves,
## the space is a header cell border in the filter row colour of the theme
#bulk-change-table:not(.hasFilters) thead th{padding:4px 18px 17px 4px}
#bulk-change-table:not(.hasFilters) thead tr{height:115px !important}
## Show Name is drawn sorted, as the table script sorts by it first
#bulk-change-table:not(.hasFilters) thead th.sort-icon-left{padding:4px 4px 17px 22px; background-repeat:no-repeat; background-position:left 0 bottom 23px}
#bulk-change-table:not(.hasFilters) thead th.sort-size{padding:4px 4px 17px}
#bulk-change-table:not(.hasFilters) thead th.col-checkbox{padding:4px 4px 17px}
#bulk-change-table:not(.hasFilters) thead th.sort-action{padding:4px 11px 17px}
## the Status and Quality widths come from their filter boxes and cells, kept when a filter leaves few or no rows
#bulk-change-table thead th.sort-icon-status{min-width:96px}
#bulk-change-table thead th.sort-icon-quality{width:62px}
#bulk-change-table thead th.filter-select{min-width:55px}
## the labels, tick all boxes and size menu stand on a common line over the sort arrows, Show Name on that line too
#bulk-change-table thead th, #bulk-change-table-sticky thead th{vertical-align:bottom; padding-bottom:17px}
@supports (transform:translateX(16px) rotate(-45deg)) and (transform-origin:bottom left){
## the Show Name arrow is clear of the tag behind the sorted label
.tablesorter.rotate th.tablesorter-header.sort-icon-left{background-position:left 0 bottom 23px; padding:4px 4px 17px 22px}
.tablesorter.rotate th.tablesorter-header.sort-icon-bottom{background-position:left 10px bottom 7px}
.tablesorter.rotate th.tablesorter-header.sort-icon-status{background-position:left 30px bottom 7px}
.tablesorter.rotate th.tablesorter-header.sort-size{background-position:center bottom 5px}
.tablesorter.rotate th.tablesorter-header.sort-icon-quality{background-position:left 20px bottom 7px}
.tablesorter.rotate th.tablesorter-header.sort-action{background-position:left 10px bottom 5px; padding:4px 11px; text-align:left}
## a tick all box stands upright under its slanted label, over the boxes of its column, as the Edit box does
.tablesorter.rotate th.sort-action input.bulk-check{display:block; margin:0 0 0 2px}
.tablesorter th.col-checkbox input.bulk-check{display:block; margin:0 auto}
## the last column, Remove, has room on its right for its slanted label, the table edge would cut it
#bulk-change-table thead th.sort-action.col-destructive, #bulk-change-table-sticky thead th.sort-action.col-destructive{padding-right:40px}
## and its row boxes stand under the header box
#bulk-change-table > tbody:not(#no-match) > tr > td:last-child,
#bulk-change-table .tablesorter-filter-row td:last-child, #bulk-change-table-sticky .tablesorter-filter-row td:last-child{padding-left:11px; padding-right:40px}
.tablesorter th.tablesorter-header.col-checkbox{background-position:center bottom 5px; padding:4px}
.rotate-holder{width:20px; margin-bottom:0}
.rotate-holder2{width:20px; margin:0 0 4px}
.rotate-body{width:25px; transform-origin:bottom left; transform:translateX(16px) rotate(-45deg)}
.rotate-body2{width:25px; transform-origin:bottom left; transform:translateX(20px) rotate(-45deg)}
.rotate-body span{float:none}
.rotate th.col-legend, .rotate td.col-legend{width:40px}
.rotate .img-warning-16{cursor:help}
}
#bulk-change-table thead,
#bulk-change-table-sticky thead,
#tfoot{position:sticky}
#bulk-change-table thead,
#bulk-change-table-sticky thead{top:50px}
#bulk-change-table-sticky,.tablesorter thead,.tablesorter thead tr,.tablesorter thead tr th, .tablesorter thead tr td{border-spacing:0}
#tfoot{bottom:0; min-height:34px; line-height:26px; z-index:3}
#tfoot input[disabled]{cursor:not-allowed}
.tablesorter-sticky-wrapper{margin-top:50px}
.tablesorter-filter-row input[disabled]{display:none}
.tablesorter-filter-row input[type="search"]{background:rgba(255,255,255,0.2); padding:0 3px; border:0; border-radius:4px; color:inherit}
## the menu sits in the Size cell before the table script runs, else it shows at the page edge while the page loads
#bulk-change-table th.sort-size, #bulk-change-table-sticky th.sort-size{width:1%; padding:4px 4px 17px; vertical-align:bottom; text-align:center}
#bulk-change-table th.sort-size select.size-type, #bulk-change-table-sticky th.sort-size select.size-type{margin-bottom:0}

#set $theme_suffix = ('', '-dark')['dark' == $sg_str('THEME_NAME', 'dark')]
.tip,.tip-average{margin:0 2px}
.tip-average{border-top:1px solid #echo ('#999', '#666')[not $theme_suffix]#}
.tip-average,.tip-average i{display:inline-block; line-height:8px}
.bfr{position:absolute;left:-999px;top:-999px}.bfr img,.spinner{display:inline-block;width:16px;height:16px}.spinner{background:url(${sbRoot}/images/loading16${theme_suffix}.gif) no-repeat 0 0}
## the skip link shows over the table header when it has the keyboard focus, and does not move the table
#skip-to-filters:focus{position:absolute; z-index:4; margin-top:4px; padding:4px 8px; background:#fff; color:#000; border-radius:2px}
</style>
<div class="bfr"><img src="$sbRoot/images/loading16${theme_suffix}.gif"></div>

